# ============================================================
# GeminiNest Local Environment Secrets Template (.env.example)
# Copy this file to `.env` and fill in your alt-account credentials.
# NEVER commit `.env` to Git or upload it to Google Drive.
# ============================================================

# Bilibili Read-Only Alt Account Cookies (extract via incognito browser only)
BILI_SESSDATA=
BILI_JCT=
BILI_BUVID3=

# Optional: Force UTF-8 encoding for Windows subprocesses & Python IO
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Note: v1 uses Antigravity Host-Driven Mode (Pro subscription), so NO Gemini API Key is required.
